<?xml version="1.0" encoding="utf-8"?>
<!-- Android cloud backup is disabled for the whole app: a backup of the DB would
     bypass the encrypted, passphrase-protected backup flow. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="file" />
    <exclude domain="external" />
</full-backup-content>
